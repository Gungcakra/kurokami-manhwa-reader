---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Info from "./_Info";

const title = "Info & Kebijakan Privasi — Kurokami";
const description = "Informasi tentang Kurokami, kebijakan privasi, penyimpanan data lokal, dan sumber konten. Kurokami tidak meng-host file media apa pun.";
---

<Layout
  title={title}
  description={description}
  keywords="info kurokami, kebijakan privasi kurokami, tentang kurokami, dmca"
>
  <Info slot="body" client:only="react" />
</Layout>
