---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Home from "./_Home";

const origin = (Astro.site ?? Astro.url).origin;
const title = "Kurokami — Baca Manhwa, Manga & Manhua Bahasa Indonesia Gratis";
const description =
  "Baca manhwa, manga, dan manhua bahasa Indonesia gratis di Kurokami. Ribuan judul populer, update chapter terbaru tiap hari, kualitas gambar HD, dan nyaman dibaca langsung dari HP tanpa perlu daftar.";

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Kurokami",
    alternateName: "Kurokami Reader",
    url: origin,
    description,
    inLanguage: "id-ID",
    potentialAction: {
      "@type": "SearchAction",
      target: {
        "@type": "EntryPoint",
        urlTemplate: `${origin}/explore?q={search_term_string}`,
      },
      "query-input": "required name=search_term_string",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: "Kurokami",
    url: origin,
    logo: new URL("/android-chrome-512x512.png", origin).href,
  },
];
---

<Layout
  title={title}
  description={description}
  keywords="baca manhwa, baca manga, baca manhua, manhwa bahasa indonesia, komik online gratis, manhwa terbaru, baca komik online, kurokami"
  jsonLd={jsonLd}
>
  <Home slot="body" client:load />
</Layout>
