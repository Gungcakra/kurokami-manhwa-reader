---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import HistoryComponent from "./_History";
export const prerender = false;

const title = "Riwayat Baca — Kurokami";
const description = "Riwayat chapter yang sudah kamu baca di Kurokami. Lanjutkan membaca dari chapter terakhir kapan saja langsung dari perangkatmu.";
---

<Layout
  title={title}
  description={description}
  keywords="riwayat baca komik, lanjut baca manhwa, history manga, kurokami"
  noindex
>
  <HistoryComponent slot="body" client:only="react" />
</Layout>
