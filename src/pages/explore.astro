---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import ExploreComponent from "./_Explore";
export const prerender = false;

const title = "Jelajah Komik — Cari Manhwa, Manga & Manhua | Kurokami";
const description = "Jelajahi ribuan judul manhwa, manga, dan manhua bahasa Indonesia di Kurokami. Saring berdasarkan genre, status, dan format, lalu baca chapter terbarunya gratis.";
---

<Layout
  title={title}
  description={description}
  keywords="jelajah komik, cari manhwa, filter genre manhwa, daftar manga indonesia, manhua bahasa indonesia, kurokami"
>
  <ExploreComponent slot="body" client:only="react" />
</Layout>
