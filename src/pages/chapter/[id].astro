---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import Chapter from "../_Chapter";

// Static build: a single `_` shell that .htaccess serves for every
// /chapter/<id>; the reader reads the id from the URL and sets the title,
// description and JSON-LD once the chapter has loaded (utils/seo.ts).
export const getStaticPaths = () => [{ params: { id: "_" } }];
---

<Layout
  title="Baca Chapter di Kurokami"
  description="Baca chapter terbaru bahasa Indonesia gratis di Kurokami dengan kualitas gambar HD."
  type="article"
>
  <Chapter slot="body" client:only="react" />
</Layout>
