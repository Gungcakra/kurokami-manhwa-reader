---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Browse from "./_Browse";

const title = "Manhwa & Manga Terpopuler Bahasa Indonesia — Kurokami";
const description = "Daftar manhwa, manga, dan manhua terpopuler dengan pembaca terbanyak di Kurokami. Temukan judul yang sedang ramai dibaca dan baca gratis bahasa Indonesia.";
---

<Layout
  title={title}
  description={description}
  keywords="manhwa terpopuler, manga populer, komik paling banyak dibaca, manhwa trending, kurokami"
>
  <Browse slot="body" type="popular" client:only="react" />
</Layout>
