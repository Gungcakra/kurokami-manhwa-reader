---
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import Detail from "../_Detail";

// Static build: a single `_` shell that .htaccess serves for every
// /manhwa/<id>; the component reads the id from the URL and sets the title,
// description and JSON-LD once the series has loaded (utils/seo.ts).
export const getStaticPaths = () => [{ params: { id: "_" } }];
---

<Layout
  title="Detail Komik — Kurokami"
  description="Detail komik di Kurokami — baca manhwa, manga, dan manhua bahasa Indonesia gratis."
  type="book"
>
  <Detail slot="body" client:only="react" />
</Layout>
