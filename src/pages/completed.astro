---
import "../styles/global.css";
import Layout from "../layouts/Layout.astro";
import Browse from "./_Browse";

const title = "Komik Tamat — Manhwa & Manga Sudah Selesai | Kurokami";
const description = "Daftar manhwa, manga, dan manhua yang sudah tamat di Kurokami. Baca dari chapter pertama sampai habis tanpa perlu menunggu update.";
---

<Layout
  title={title}
  description={description}
  keywords="komik tamat, manhwa tamat, manga selesai, manhwa end, baca komik sampai habis, kurokami"
>
  <Browse slot="body" type="completed" client:only="react" />
</Layout>
